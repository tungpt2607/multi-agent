{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "description",
    "workflow",
    "status",
    "waiting_on",
    "token_budget",
    "token_used",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REQ-\\d{4}$"
    },
    "type": {
      "enum": [
        "development",
        "business"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "workflow": {
      "type": "string"
    },
    "status": {
      "enum": [
        "intake",
        "analysis",
        "design",
        "planning",
        "execution",
        "verification",
        "delivered",
        "cancelled"
      ]
    },
    "waiting_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DEC-\\d{4}$"
      }
    },
    "token_budget": {
      "type": "integer",
      "minimum": 0
    },
    "token_used": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}